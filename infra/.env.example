# Local development values ONLY. They protect nothing: the ports are bound to
# 127.0.0.1. Copy to infra/.env (git-ignored) and change them if you like.
# Never reuse these values anywhere else, and never put a real secret here.
POSTGRES_USER=petria_dev
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=petria
RABBITMQ_DEFAULT_USER=petria_dev
RABBITMQ_DEFAULT_PASS=change-me-dev-only
